{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Licht Launcher",
  "version": "0.1.0",
  "identifier": "app.licht.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Licht Launcher",
        "theme": "Dark",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 560,
        "maxWidth": 1200,
        "maxHeight": 960,
        "fullscreen": false,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
