{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Licht Launcher",
  "version": "0.1.0",
  "identifier": "app.licht.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Licht Launcher",
        "theme": "Dark",
        "backgroundColor": "#121212",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 560,
        "maxWidth": 1200,
        "maxHeight": 960,
        "fullscreen": false,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
