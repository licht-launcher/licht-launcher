{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Licht Launcher",
  "version": "0.2.1",
  "identifier": "app.licht.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$LOCALAPPDATA/**",
            "$HOME/**",
            "$XDG_DATA_HOME/**"
          ],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": {
        "default-src": "'none'",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "font-src": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' https: asset: http://asset.localhost https://asset.localhost",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost http://localhost:5173 http://127.0.0.1:5173 ws://localhost:5173 ws://127.0.0.1:5173",
        "font-src": "'self'",
        "img-src": "'self' https: asset: http://asset.localhost https://asset.localhost http://localhost:5173 http://127.0.0.1:5173",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'"
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDODE2QThGQ0VERDc2NTcKUldSWGR0M09qMnFCWERIMzBsR1B1RHphV0p4OCtrNTJqbnlHM25oQjgxcDFKRi9adjVPM0piZE8K",
      "endpoints": [
        "https://github.com/mateusneiva/licht-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
