# Optional. Overrides the client ID embedded in the binary (forks / local experiments).
# Copy to `.env` in the repo root (gitignored). Official builds do not need this.
# LICHT_MSA_CLIENT_ID=

# Optional. Enables CurseForge modpack search/import in the New Instance wizard.
# Without this key, Modrinth packs still work. Never commit a real key.
# See docs/modpacks/CURSEFORGE.md.
# LICHT_CURSEFORGE_API_KEY=
