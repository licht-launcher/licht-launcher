{
  "name": "licht-launcher",
  "version": "0.3.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:e2e": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "build:web": "tsc -b && vite build",
    "build:web:e2e": "tsc -b && vite build --mode e2e",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "format:rust": "cargo fmt --all",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "test:rust": "cargo test --workspace --locked",
    "check": "pnpm check:web && pnpm check:rust",
    "check:web": "pnpm lint && pnpm typecheck && pnpm test",
    "check:rust": "cargo fmt --all --check && pnpm lint:rust && pnpm test:rust",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/react": "0.5.1",
    "@fontsource/google-sans": "^5.3.2",
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-virtual": "3.14.14",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "html-react-parser": "6.1.9",
    "lucide-react": "1.53.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.5",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "shadcn>zod": ">=4.6.6",
      "@shadcn/registry>zod": ">=4.6.6",
      "@ts-morph/common>minimatch": ">=11.0.1"
    }
  }
}
